{
    "include": [
      "*.js"
    ],
    "exclude": [
      "test/**",
      "node_modules/**"
    ],
    "all": true,
    "reporter": [
      "html",
      "text"
    ],
    "check-coverage": true,
    "per-file": true,
    "lines": 80,
    "statements": 80,
    "functions": 80,
    "branches": 80
  }